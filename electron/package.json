{
  "name": "jarvis-desktop",
  "version": "1.0.0-rc6",
  "description": "Ooplix - AI Operating System Desktop Application. NOTE: real packaging/release builds run from the repo root (see root package.json's \"build\" block and .github/workflows/release.yml) — this file's own \"build\"/\"build-app*\" scripts are a legacy standalone dev setup kept in sync only for appId/productName/electron version so they no longer produce a mismatched artifact if ever invoked directly.",
  "main": "main.cjs",
  "homepage": "./",
  "author": "JARVIS Team",
  "license": "MIT",
  "scripts": {
    "dev": "PORT=3001 react-scripts start",
    "build": "react-scripts build",
    "start": "electron .",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "cross-env ELECTRON_START_URL=http://localhost:3001 electron .",
    "build-app": "npm run build && electron-builder --publish=never",
    "build-app-mac": "npm run build && electron-builder -m",
    "build-app-linux": "npm run build && electron-builder -l",
    "build-app-win": "npm run build && electron-builder -w",
    "lint": "eslint src",
    "test": "react-scripts test --watchAll=false"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-is-dev": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "react-speech-recognition": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.4.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.ooplix.jarvis",
    "productName": "Ooplix",
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "electron/assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/assets/icon.ico"
    }
  }
}
