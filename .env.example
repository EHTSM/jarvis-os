# ════════════════════════════════════════════════════════════════════════
#  JARVIS OS — Production environment template
#  Copy to .env and fill in EVERY value before running start-production.sh
#
#  Lines marked [REQUIRED] crash or disable a core feature if blank.
#  Lines marked [OPTIONAL] only disable a non-critical feature if blank.
#
#  Regenerated 2026-07-25 via a full repo credential-contract scan.
#  See docs/audits/CREDENTIAL-CANONICAL-MAP.md for canonical key, alias,
#  and code-location detail behind every line below. Only variables the
#  CURRENT code actually reads are listed — nothing invented.
# ════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────
PORT=5050
HOST=
# Comma-separated list of allowed CORS origins (no trailing slash).
ALLOWED_ORIGINS=https://yourdomain.com
NODE_ENV=production

# [REQUIRED] Public HTTPS domain — used for Razorpay webhook callbacks,
# OAuth redirect defaults, and AI provider Referer headers.
BASE_URL=https://your-domain.com
# [OPTIONAL] Overrides BASE_URL specifically for AI provider HTTP-Referer
# headers (aiService.js) and some OAuth redirect fallbacks.
APP_URL=
# [OPTIONAL] Read by pipReport.cjs's production-readiness check only.
PRODUCTION_DOMAIN=
# [OPTIONAL] Electron/desktop split-server backend URL.
BACKEND_URL=

# [REQUIRED in production] Generate with: node scripts/generate-password-hash.cjs <yourpassword>
OPERATOR_PASSWORD_HASH=
# [REQUIRED in production] Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also used to derive the Vault's AES-256-GCM encryption key — rotating
# this orphans existing Vault entries (see secretVault.cjs).
JWT_SECRET=
# [OPTIONAL, dev only] Bypasses operator auth — never set in production.
ALLOW_DEV_AUTH_BYPASS=

LOG_LEVEL=INFO
LOG_FILE=

# ─── Business / product config (not secrets) ───────────────────────────
PRODUCT_NAME=JARVIS AI
PRODUCT_DESC=
PRODUCT_PRICE=999
OPERATOR_CONTACT=
FOUNDER_EMAIL=

# ════════════════════════════════════════════════════════════════════════
# AI Providers — 14 real, implemented providers (aiService.js)
# LLM_PROVIDER picks the preferred one; all others are automatic fallbacks.
# ════════════════════════════════════════════════════════════════════════
LLM_PROVIDER=groq

# [REQUIRED] Groq — fast, free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_TIMEOUT=20000

# [OPTIONAL] OpenRouter — multi-model fallback aggregator
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT=25000

# [OPTIONAL] OpenAI — also used for Whisper STT
OPENAI_API_KEY=
OPENAI_TIMEOUT=20000
OPENAI_MODEL=

# [OPTIONAL] Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT=30000

# [OPTIONAL] Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=25000

# [OPTIONAL] DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=25000

# [OPTIONAL] Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf
TOGETHER_TIMEOUT=25000

# [OPTIONAL] Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3-70b-instruct
FIREWORKS_TIMEOUT=25000

# [OPTIONAL] Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus
COHERE_TIMEOUT=25000

# [OPTIONAL] NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_TIMEOUT=30000

# [OPTIONAL] Grok (xAI)
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_TIMEOUT=25000

# [OPTIONAL] Qwen (Alibaba DashScope)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_REGION=intl
QWEN_TIMEOUT=25000

# [OPTIONAL] Ollama — local runtime, no key required
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30000

# [OPTIONAL] LM Studio — local runtime, no key required
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=30000

# ─── Voice (TTS/STT) ────────────────────────────────────────────────────
# [OPTIONAL] ElevenLabs — falls back to OPENAI_API_KEY (Whisper) if unset
ELEVENLABS_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# Git Providers
# ════════════════════════════════════════════════════════════════════════
# GitHub — two DISTINCT credentials, not interchangeable:
#   GITHUB_TOKEN = Personal Access Token (git:github connector — repo API access)
#   GITHUB_CLIENT_ID/SECRET = OAuth App (auth:github connector — user sign-in)
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# [OPTIONAL] Declared in envManager.cjs's catalog; not read by any connect*() function today.
GITHUB_APP_ID=

GITLAB_TOKEN=
# Alias accepted: GITLAB_ACCESS_TOKEN
GITLAB_HOST=https://gitlab.com

BITBUCKET_USER=
# Alias accepted: BITBUCKET_USERNAME
BITBUCKET_APP_PASSWORD=
# Alias accepted: BITBUCKET_TOKEN

# ════════════════════════════════════════════════════════════════════════
# Infrastructure / Cloud
# ════════════════════════════════════════════════════════════════════════
HOSTINGER_API_KEY=

CLOUDFLARE_API_TOKEN=
# Alias accepted: CF_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=

# [OPTIONAL] Enables mobile app auth
FIREBASE_PROJECT_ID=
# Paste the full service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AWS S3 — also used by AWS SES (email) below
AWS_ACCESS_KEY_ID=
# Alias accepted: S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=
# Alias accepted: S3_SECRET_KEY
AWS_REGION=us-east-1
# Alias accepted: S3_REGION
S3_BUCKET=
S3_ENDPOINT=

# Cloudflare R2 (S3-compatible object storage — separate from the Cloudflare API token above)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Alias accepted: CLOUDFLARE_R2_BUCKET
R2_ACCOUNT_ID=
R2_ENDPOINT=

# ════════════════════════════════════════════════════════════════════════
# Payments
# ════════════════════════════════════════════════════════════════════════
# ─── Razorpay ──────────────────────────────────────────────────────────
# [REQUIRED for payments] Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
# Alias accepted: RAZORPAY_KEY
RAZORPAY_KEY_SECRET=
# Alias accepted: RAZORPAY_SECRET — NOTE: this field bypasses the Vault's
# ENV_MAP entirely (read directly via process.env in webhookController.js/
# billingService.js) — see CREDENTIAL-CANONICAL-MAP.md.
# [REQUIRED in production] Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# Subscription plan IDs — billingService.js builds the env key dynamically
# as RAZORPAY_PLAN_ID_<PLAN.toUpperCase()> from its own real plan set
# (trial | starter | growth | scale). "ENTERPRISE" (seen in older docs/
# rc1.cjs output) does NOT match any current plan name — SCALE is correct.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_SCALE=

# ─── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Paddle ─────────────────────────────────────────────────────────────
PADDLE_API_KEY=
PADDLE_VENDOR_ID=
PADDLE_WEBHOOK_SECRET=

# ─── LemonSqueezy ───────────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Payments kill switch ───────────────────────────────────────────────
DISABLE_PAYMENTS=

# ════════════════════════════════════════════════════════════════════════
# Email
# ════════════════════════════════════════════════════════════════════════
# [REQUIRED for beta] resend.com → API Keys → Create API Key
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
POSTMARK_API_KEY=
BREVO_API_KEY=

# Amazon SES rides the AWS credentials above — this only needs the region.
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Default "from" sender — emailService.cjs reads SMTP_FROM first, then
# EMAIL_FROM. RESEND_FROM_EMAIL (seen in older RC1/RC2 docs) is NOT read
# by any current code — do not rely on it.
SMTP_FROM=noreply@yourdomain.com

# ════════════════════════════════════════════════════════════════════════
# Messaging
# ════════════════════════════════════════════════════════════════════════
# ─── WhatsApp (Meta Business Cloud API) ────────────────────────────────
WA_TOKEN=
# Alias accepted: WHATSAPP_TOKEN
WA_PHONE_ID=
# Alias accepted: PHONE_NUMBER_ID — must be a phone-number-id, NOT the
# WhatsApp Business Account ID (a documented, real prior mismatch).
WA_BUSINESS_ACCOUNT_ID=
WA_VERIFY_TOKEN=change_this_to_a_random_secret
WA_API_VERSION=v19.0
DISABLE_WHATSAPP=

# ─── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
# Fallback Razorpay link shown in Telegram if dynamic link creation fails
PAYMENT_FALLBACK_LINK=
# Chat ID to receive crash alerts and EOD summaries — https://t.me/userinfobot
TELEGRAM_OPERATOR_CHAT_ID=

# ─── Twilio ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Discord ────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

# ─── Slack ──────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── Microsoft Teams — rides the Microsoft OAuth app below ─────────────
TEAMS_WEBHOOK_URL=

# ════════════════════════════════════════════════════════════════════════
# Authentication (consumer sign-in OAuth apps)
# ════════════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=
# Fallback token if the real OAuth flow (above) hasn't been completed yet
MS_GRAPH_TOKEN=
# Alias accepted: MICROSOFT_GRAPH_TOKEN

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=

APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
# Contents of downloaded .p8 file (single line)
APPLE_PRIVATE_KEY=

# (Discord OAuth reuses DISCORD_CLIENT_ID/SECRET/REDIRECT_URI above)
# (Notion OAuth reuses NOTION_CLIENT_ID/SECRET below)

# ════════════════════════════════════════════════════════════════════════
# Productivity
# ════════════════════════════════════════════════════════════════════════
DROPBOX_ACCESS_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Notion — direct integration token (simplest) OR OAuth app (below)
NOTION_API_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# ════════════════════════════════════════════════════════════════════════
# Commerce
# ════════════════════════════════════════════════════════════════════════
SHOPIFY_STORE_DOMAIN=
# Alias accepted: SHOPIFY_DOMAIN — mystore.myshopify.com (no https://)
SHOPIFY_ADMIN_TOKEN=
# Alias accepted: SHOPIFY_ACCESS_TOKEN

WOOCOMMERCE_URL=
# Alias accepted: WC_URL
WOOCOMMERCE_KEY=
# Alias accepted: WC_CONSUMER_KEY
WOOCOMMERCE_SECRET=
# Alias accepted: WC_CONSUMER_SECRET

WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ════════════════════════════════════════════════════════════════════════
# Creative
# ════════════════════════════════════════════════════════════════════════
FIGMA_ACCESS_TOKEN=
# Alias accepted: FIGMA_TOKEN

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# Automation
# ════════════════════════════════════════════════════════════════════════
ZAPIER_WEBHOOK_URL=
# Alias accepted: ZAPIER_CATCH_HOOK

MAKE_API_KEY=
# Alias accepted: MAKE_API_TOKEN
MAKE_WEBHOOK_URL=
# Alias accepted: INTEGROMAT_WEBHOOK_URL

N8N_HOST=
# Alias accepted: N8N_BASE_URL
N8N_API_KEY=
N8N_WEBHOOK_URL=

# ════════════════════════════════════════════════════════════════════════
# Monitoring
# ════════════════════════════════════════════════════════════════════════
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

UPTIMEROBOT_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# Project Management
# ════════════════════════════════════════════════════════════════════════
JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=

LINEAR_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# Operations
# ════════════════════════════════════════════════════════════════════════
# [OPTIONAL] Encrypts backups produced by scripts/export-offsite.cjs
BACKUP_PASSWORD=
# [OPTIONAL] Offsite transfer destination for scripts/export-offsite.cjs
# (invoked automatically by safe-backup.cjs's daily 02:00 cron job — see
# ecosystem.config.cjs's ooplix-backup entry). Leave blank to encrypt
# locally only, with no offsite copy.
#   SSH/rsync:  user@host:/path/to/backups   (requires passwordless SSH key
#               auth already configured to that host — set up manually,
#               never store an SSH password here)
#   S3:         s3://bucket-name/prefix      (requires AWS CLI configured,
#               e.g. `aws configure`, on this machine)
#   Local/scratch dir: any plain absolute path with no ':' — e.g. a mounted
#               secondary disk or network share
BACKUP_OFFSITE_DIR=
# Alias accepted: BACKUP_DEST
# [OPTIONAL] Webhook URL for internal ops alerts
OPS_WEBHOOK_URL=

# ─── Beta / launch config ───────────────────────────────────────────────
# Hard limit on registered beta accounts (default: 50).
BETA_MAX_USERS=50
OPEN_SIGNUP=

# ─── Single-agent utility integrations (not part of Connector Registry) ─
GNEWS_API_KEY=
OPENWEATHER_API_KEY=

# ─── Frontend build-time ────────────────────────────────────────────────
# Single-server (nginx proxies API routes): leave BLANK — relative paths are used.
# Split-server (api.yourdomain.com separate backend): set to your API domain.
REACT_APP_API_URL=

# Firebase — mobile app auth only (frontend build-time, public by design)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ─── Desktop/Electron ───────────────────────────────────────────────────
ENABLE_LOCAL_DESKTOP=
ENABLE_RUNTIME_DESKTOP=

# ─── Test/internal (do not set in production) ──────────────────────────
DEBUG=
DEBUG_PIPELINE=
COOKIE_DOMAIN=
DISABLE_X_POWERED_BY=
ENABLE_CSP=
