# ════════════════════════════════════════════════════════════════════════
# Operations
# ════════════════════════════════════════════════════════════════════════
# [OPTIONAL] Encrypts backups produced by scripts/export-offsite.cjs
BACKUP_PASSWORD=
# [OPTIONAL] Offsite transfer destination for scripts/export-offsite.cjs
# (invoked automatically by safe-backup.cjs's daily 02:00 cron job — see
# ecosystem.config.cjs's ooplix-backup entry). Leave blank to encrypt
# locally only, with no offsite copy.
#   SSH/rsync:  user@host:/path/to/backups   (requires passwordless SSH key
#               auth already configured to that host — set up manually,
#               never store an SSH password here)
#   S3:         s3://bucket-name/prefix      (requires AWS CLI configured,
#               e.g. `aws configure`, on this machine)
#   Local/scratch dir: any plain absolute path with no ':' — e.g. a mounted
#               secondary disk or network share
BACKUP_OFFSITE_DIR=
# Alias accepted: BACKUP_DEST
# [OPTIONAL] Webhook URL for internal ops alerts
OPS_WEBHOOK_URL=

# ─── Beta / launch config ───────────────────────────────────────────────
# Hard limit on registered beta accounts (default: 50).
BETA_MAX_USERS=50
OPEN_SIGNUP=

# ─── Single-agent utility integrations (not part of Connector Registry) ─
GNEWS_API_KEY=
OPENWEATHER_API_KEY=

# ─── Frontend build-time ────────────────────────────────────────────────
# Single-server (nginx proxies API routes): leave BLANK — relative paths are used.
# Split-server (api.yourdomain.com separate backend): set to your API domain.
REACT_APP_API_URL=

# Firebase — mobile app auth only (frontend build-time, public by design)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ─── Desktop/Electron ───────────────────────────────────────────────────
ENABLE_LOCAL_DESKTOP=
ENABLE_RUNTIME_DESKTOP=

# ─── Test/internal (do not set in production) ──────────────────────────
DEBUG=
DEBUG_PIPELINE=
COOKIE_DOMAIN=
DISABLE_X_POWERED_BY=
ENABLE_CSP=
