# ════════════════════════════════════════════════════════════════════════
#  JARVIS OS — Production environment template
#  Copy to .env and fill in EVERY value before running start-production.sh
#
#  Lines marked [REQUIRED] crash or disable a core feature if blank.
#  Lines marked [OPTIONAL] only disable a non-critical feature if blank.
#
#  Regenerated 2026-07-25 via a full repo credential-contract scan.
#  See docs/audits/CREDENTIAL-CANONICAL-MAP.md for canonical key, alias,
#  and code-location detail behind every line below. Only variables the
#  CURRENT code actually reads are listed — nothing invented.
# ════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────
PORT=5050
HOST=
# Comma-separated list of allowed CORS origins (no trailing slash).
ALLOWED_ORIGINS=https://yourdomain.com
NODE_ENV=production

# [REQUIRED] Public HTTPS domain — used for Razorpay webhook callbacks,
# OAuth redirect defaults, and AI provider Referer headers.
BASE_URL=https://your-domain.com
# [OPTIONAL] Overrides BASE_URL specifically for AI provider HTTP-Referer
# headers (aiService.js) and some OAuth redirect fallbacks.
APP_URL=
# [OPTIONAL] Read by pipReport.cjs's production-readiness check only.
PRODUCTION_DOMAIN=
# [OPTIONAL] Electron/desktop split-server backend URL.
BACKEND_URL=

# [REQUIRED in production] Generate with: node scripts/generate-password-hash.cjs <yourpassword>
OPERATOR_PASSWORD_HASH=
# [REQUIRED in production] Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also used to derive the Vault's AES-256-GCM encryption key — rotating
# this orphans existing Vault entries (see secretVault.cjs).
JWT_SECRET=
# [OPTIONAL, dev only] Bypasses operator auth — never set in production.
ALLOW_DEV_AUTH_BYPASS=

LOG_LEVEL=INFO
LOG_FILE=

# ─── Business / product config (not secrets) ───────────────────────────
PRODUCT_NAME=JARVIS AI
PRODUCT_DESC=
PRODUCT_PRICE=999
OPERATOR_CONTACT=
FOUNDER_EMAIL=

# ════════════════════════════════════════════════════════════════════════
# AI Providers — 14 real, implemented providers (aiService.js)
# LLM_PROVIDER picks the preferred one; all others are automatic fallbacks.
# ════════════════════════════════════════════════════════════════════════
LLM_PROVIDER=groq

# [REQUIRED] Groq — fast, free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_TIMEOUT=20000

# [OPTIONAL] OpenRouter — multi-model fallback aggregator
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT=25000

# [OPTIONAL] OpenAI — also used for Whisper STT
OPENAI_API_KEY=
OPENAI_TIMEOUT=20000
OPENAI_MODEL=

# [OPTIONAL] Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT=30000

# [OPTIONAL] Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=25000

# [OPTIONAL] DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=25000

# [OPTIONAL] Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf
TOGETHER_TIMEOUT=25000

# [OPTIONAL] Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3-70b-instruct
FIREWORKS_TIMEOUT=25000

# [OPTIONAL] Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus
COHERE_TIMEOUT=25000

# [OPTIONAL] NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_TIMEOUT=30000

# [OPTIONAL] Grok (xAI)
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_TIMEOUT=25000

# [OPTIONAL] Qwen (Alibaba DashScope)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_REGION=intl
QWEN_TIMEOUT=25000

# [OPTIONAL] Ollama — local runtime, no key required
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30000

# [OPTIONAL] LM Studio — local runtime, no key required
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=30000

# ─── Voice (TTS/STT) ────────────────────────────────────────────────────
# [OPTIONAL] ElevenLabs — falls back to OPENAI_API_KEY (Whisper) if unset
ELEVENLABS_API_KEY=

# ════════════════════════════════════════════════════════════════════════
# Git Providers
# ════════════════════════════════════════════════════════════════════════
# GitHub — two DISTINCT credentials, not interchangeable:
#   GITHUB_TOKEN = Personal Access Token (git:github connector — repo API access)
#   GITHUB_CLIENT_ID/SECRET = OAuth App (auth:github connector — user sign-in)
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# [OPTIONAL] Declared in envManager.cjs's catalog; not read by any connect*() function today.
GITHUB_APP_ID=

GITLAB_TOKEN=
# Alias accepted: GITLAB_ACCESS_TOKEN
GITLAB_HOST=https://gitlab.com

BITBUCKET_USER=
# Alias accepted: BITBUCKET_USERNAME
BITBUCKET_APP_PASSWORD=
# Alias accepted: BITBUCKET_TOKEN

# ════════════════════════════════════════════════════════════════════════
# Infrastructure / Cloud
# ════════════════════════════════════════════════════════════════════════
HOSTINGER_API_KEY=

CLOUDFLARE_API_TOKEN=
# Alias accepted: CF_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=

# [OPTIONAL] Enables mobile app auth
FIREBASE_PROJECT_ID=
# Paste the full service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AWS S3 — also used by AWS SES (email) below
AWS_ACCESS_KEY_ID=
# Alias accepted: S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=
# Alias accepted: S3_SECRET_KEY
AWS_REGION=us-east-1
# Alias accepted: S3_REGION
S3_BUCKET=
S3_ENDPOINT=

# Cloudflare R2 (S3-compatible object storage — separate from the Cloudflare API token above)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Alias accepted: CLOUDFLARE_R2_BUCKET
R2_ACCOUNT_ID=
R2_ENDPOINT=

# ════════════════════════════════════════════════════════════════════════
# Payments
# ════════════════════════════════════════════════════════════════════════
# ─── Razorpay ──────────────────────────────────────────────────────────
# [REQUIRED for payments] Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
# Alias accepted: RAZORPAY_KEY
RAZORPAY_KEY_SECRET=
# Alias accepted: RAZORPAY_SECRET — NOTE: this field bypasses the Vault's
# ENV_MAP entirely (read directly via process.env in webhookController.js/
# billingService.js) — see CREDENTIAL-CANONICAL-MAP.md.
# [REQUIRED in production] Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# Subscription plan IDs — billingService.js builds the env key dynamically
# as RAZORPAY_PLAN_ID_<PLAN.toUpperCase()> from its own real plan set
# (trial | starter | growth | scale). "ENTERPRISE" (seen in older docs/
# rc1.cjs output) does NOT match any current plan name — SCALE is correct.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_SCALE=

# ─── Stripe ─────────────────────────────────────────────────────────────
# [REQUIRED for Stripe Checkout] Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# [REQUIRED in production] Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=

# Optional — a pre-created Stripe recurring Price id per plan (Dashboard →
# Product catalog). Same dynamic-env-key convention as
# RAZORPAY_PLAN_ID_<PLAN> above: stripeService.js/payment.js build the key
# as STRIPE_PRICE_ID_<PLAN.toUpperCase()>. Only starter/growth/scale exist
# as real plans (billingService.PLAN_PRICES) — do not invent others. If
# unset for a plan, checkout falls back to an ad hoc one-time price built
# server-side from billingService.PLAN_PRICES (one-time payment only —
# Stripe Checkout subscriptions require a real recurring Price id, so a
# plan with no Price id configured here can only checkout in "payment"
# mode, not "subscription" mode).
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=

# ─── Paddle ─────────────────────────────────────────────────────────────
PADDLE_API_KEY=
PADDLE_VENDOR_ID=
PADDLE_WEBHOOK_SECRET=

# ─── LemonSqueezy ───────────────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Payments kill switch ───────────────────────────────────────────────
DISABLE_PAYMENTS=

# ════════════════════════════════════════════════════════════════════════
# Email
# ════════════════════════════════════════════════════════════════════════
# [REQUIRED for beta] resend.com → API Keys → Create API Key
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
POSTMARK_API_KEY=
BREVO_API_KEY=

# Amazon SES rides the AWS credentials above — this only needs the region.
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Default "from" sender — emailService.cjs reads SMTP_FROM first, then
# EMAIL_FROM. RESEND_FROM_EMAIL (seen in older RC1/RC2 docs) is NOT read
# by any current code — do not rely on it.
SMTP_FROM=noreply@yourdomain.com

# ════════════════════════════════════════════════════════════════════════
# Social Publishing (Mission 60 — was undocumented; M59 audit flagged this
# as a gap since no other integrated provider was missing its .env.example
# template)
# ════════════════════════════════════════════════════════════════════════
# ─── X (Twitter) — API v2, real posting via socialPostingService.cjs ───
TWITTER_BEARER_TOKEN=
# Alias accepted: X_BEARER_TOKEN
# Alternative: connect per-org via POST /my-connectors/twitter instead of a
# single global token (see myConnectors.js's "twitter" provider entry).
DISABLE_SOCIAL_POSTING=

# ─── LinkedIn — UGC Posts API, real posting via linkedinPostingService.cjs
# Rides the SAME OAuth app as LinkedIn sign-in (LINKEDIN_CLIENT_ID/SECRET
# below, under Authentication) — no separate credential needed. Just
# ensure the app requests the w_member_social scope (already the default
# in oauthIntegrationLayer.cjs) and complete GET /vault/oauth/linkedin/authorize.
# Alternative: connect per-org via POST /my-connectors/linkedin with an
# existing access token instead of the interactive OAuth flow.

# ─── Facebook — Graph API Page publishing via facebookPostingService.cjs
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
# NOTE: pages_manage_posts/pages_read_engagement require Meta App Review
# (business verification + screencast) before Page publishing will work in
# production — a token can be issued without it, but /feed calls will fail
# with a permissions error until Review is granted. This is an external
# approval process, not something fixable by configuration alone.
# Alternative: connect per-org via POST /my-connectors/facebook with an
# existing Page access token + Page ID instead of the interactive OAuth flow.

# ─── Instagram — rides the SAME Facebook connection above ──────────────
# No separate credentials: instagramPostingService.cjs resolves through
# the FACEBOOK_APP_ID/SECRET connection (Meta's real model — an Instagram
# Business/Creator account must be linked to a Facebook Page; there is no
# independent Instagram developer app). Just ensure the linked Page's
# Instagram account is a Business or Creator account (personal accounts
# cannot use the Content Publishing API at all, a real provider limit).
# Alternative: connect per-org via POST /my-connectors/instagram with an
# existing Page access token + Instagram Business Account ID.

# ─── Threads — real Threads API (own OAuth app, distinct from Instagram/
# Facebook despite being a Meta product) via threadsPostingService.cjs ──
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=
# NOTE: threads_content_publish requires Meta App Review, the same
# category of external approval gate as Facebook/Instagram above.
# Alternative: connect per-org via POST /my-connectors/threads with an
# existing access token + Threads User ID.

# ─── Pinterest — Pinterest API v5 via pinterestPostingService.cjs ──────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
# Alternative: connect per-org via POST /my-connectors/pinterest with an
# existing access token instead of the interactive OAuth flow.

# ─── Reddit — real OAuth2 submit via redditPostingService.cjs ──────────
# Create a "web app" type at reddit.com/prefs/apps (not "script" — this is
# a real user-facing connect flow, not a single-account personal script).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=
# Alternative: connect per-org via POST /my-connectors/reddit with an
# existing access token instead of the interactive OAuth flow.
# NOTE: the existing agents/internet/socialMediaAgent.cjs (public,
# read-only Reddit/HN feed reading) is unrelated and unaffected — this
# section covers the separate submit/write path only.

# ─── Google Business Profile — Local Posts API via gbpPostingService.cjs
# (final of 13 social platforms) ────────────────────────────────────────
# Falls back to GOOGLE_CLIENT_ID/SECRET if unset (same pattern as YouTube
# above) — a distinct OAuth client keeps business.manage consent separate
# from Gmail/Drive/YouTube connections.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REDIRECT_URI=
# NOTE: the Business Profile Performance/Posts APIs are NOT self-service —
# Google requires a manual API-access request (a form + review) before a
# Google Cloud project can call them at all, even in testing. This is a
# distinct, separate external gate from YouTube's OAuth verification above.
# Alternative: connect per-org via POST /my-connectors/gbp with an
# existing access token instead of the interactive OAuth flow.

# ─── YouTube — Data API v3 video upload via youtubePostingService.cjs ──
# Falls back to GOOGLE_CLIENT_ID/SECRET if unset (same Google Cloud project
# can serve both, but a distinct OAuth client keeps YouTube consent/scopes
# separate from Gmail/Drive connections).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# NOTE: apps requesting youtube.upload in production (not just testing
# mode) require Google's OAuth verification process (and, for >100 users,
# a YouTube API audit) — an external approval process, same category of
# gate as Facebook's App Review above.
# Alternative: connect per-org via POST /my-connectors/youtube with an
# existing refresh token instead of the interactive OAuth flow.

# ─── TikTok — Content Posting API via tiktokPostingService.cjs ─────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# NOTE: video.publish only posts publicly once the TikTok Developer app
# reaches "Audited" review status. An unaudited (sandbox) app can still
# authorize and call this API, but every post is forced private/self-view,
# visible only to test users explicitly added in the Developer Portal — an
# external, non-code approval process, same category as Facebook/YouTube above.
# Alternative: connect per-org via POST /my-connectors/tiktok with an
# existing access token instead of the interactive OAuth flow.

# ════════════════════════════════════════════════════════════════════════
# Messaging
# ════════════════════════════════════════════════════════════════════════
# ─── WhatsApp (Meta Business Cloud API) ────────────────────────────────
WA_TOKEN=
# Alias accepted: WHATSAPP_TOKEN
WA_PHONE_ID=
# Alias accepted: PHONE_NUMBER_ID — must be a phone-number-id, NOT the
# WhatsApp Business Account ID (a documented, real prior mismatch).
WA_BUSINESS_ACCOUNT_ID=
WA_VERIFY_TOKEN=change_this_to_a_random_secret
WA_API_VERSION=v19.0
DISABLE_WHATSAPP=

# ─── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
# Fallback Razorpay link shown in Telegram if dynamic link creation fails
PAYMENT_FALLBACK_LINK=
# Chat ID to receive crash alerts and EOD summaries — https://t.me/userinfobot
TELEGRAM_OPERATOR_CHAT_ID=

# ─── Twilio ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Discord ────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

# ─── Slack ──────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_WEBHOOK_URL=

# ─── Microsoft Teams — rides the Microsoft OAuth app below ─────────────
TEAMS_WEBHOOK_URL=

