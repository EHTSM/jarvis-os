# Authentication (consumer sign-in OAuth apps)
# ════════════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=
# Fallback token if the real OAuth flow (above) hasn't been completed yet
MS_GRAPH_TOKEN=
# Alias accepted: MICROSOFT_GRAPH_TOKEN

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=

APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
