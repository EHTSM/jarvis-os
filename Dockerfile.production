# ═══════════════════════════════════════════════════════════════════════
#  JARVIS OS — Production Dockerfile
#
#  Build:   docker build -f Dockerfile.production -t jarvis-os:latest .
#  Run:     docker-compose -f docker-compose.prod.yml up -d
#
#  Security:
#    - Runs as non-root user (jarvis, UID 1001)
#    - No dev dependencies installed
#    - Frontend built in separate stage (build artifacts only in final image)
#    - .env is NOT baked in — mounted via docker-compose env_file
# ═══════════════════════════════════════════════════════════════════════

# ── Stage 1: Build frontend ──────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder

WORKDIR /build

# Copy only package files first for layer caching.
# Same exit-code-preservation fix as the runtime stage's npm ci below —
# frontend/ has no native dependencies today (verified: no sharp/sqlite/
# pty-like packages in frontend/package.json), so this specific stage
# isn't currently exposed to the toolchain failure that broke the runtime
# stage, but piping npm ci straight into grep silently discards ANY future
# install failure the same way, so it gets the identical fix for
# consistency rather than leaving one of the two npm ci calls in this file
# still able to mask a real failure.
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci --omit=dev > /tmp/npm-ci-frontend.log 2>&1; ec=$?; \
    grep -v "^npm warn" /tmp/npm-ci-frontend.log || true; \
    if [ "$ec" != "0" ]; then echo "npm ci (frontend) FAILED (exit $ec)" >&2; exit "$ec"; fi

# Copy source and build
COPY frontend/ ./frontend/
ARG REACT_APP_API_URL
RUN cd frontend && REACT_APP_API_URL="${REACT_APP_API_URL}" npm run build

# ── Stage 2: Build native modules ────────────────────────────────────────
# Packaging Certification finding: the previous `npm ci --ignore-scripts`
# combined with `|| true` masked two real, compounding failures —
# reproduced with `docker build --no-cache`:
#   1. `--ignore-scripts` skips better-sqlite3's install step entirely,
#      leaving ZERO native binary (verified: a fresh --ignore-scripts
#      install produces no .node file at all, not a wrong-ABI one).
#   2. Removing --ignore-scripts to fix (1) surfaces that `npm ci` was
#      never actually succeeding on this base image: without scripts
#      enabled, node-pty (no musl-arm64 prebuild published) and
#      better-sqlite3 both need python3/make/g++ to compile from source,
#      and a THIRD dependency, @authenio/xsd-schema-validator (used by
#      ssoService.cjs's optional SAML XSD pre-validation — already
#      gracefully degraded in application code if unavailable), needs
#      `javac` in its postinstall. With none of that present, `npm ci`
#      exited 127 — but `|| true` swallowed it, so the Docker build
#      reported success with an EMPTY node_modules (verified: `ls
#      node_modules | wc -l` → 0 in the resulting image; `require`ing
#      express itself would have crashed the container on every boot).
# sharp is NOT rebuilt here — verified separately that its @img/sharp-*
# optional dependencies resolve a working musl binary with zero install
# script, even under --ignore-scripts.
# This build stage carries the full toolchain (~400MB combined) so `npm
# ci` (no --ignore-scripts, no `|| true` masking a real failure) succeeds
# for real; only the resulting node_modules is copied into the slim
# runtime stage below, so none of this weight reaches production.
FROM node:20-alpine AS native-builder
RUN apk add --no-cache python3 make g++ openjdk17-jdk
WORKDIR /build
COPY package*.json ./
# Alpine's /bin/sh is BusyBox ash — no $PIPESTATUS, so piping npm ci
# straight into `grep -v` (the previous approach) silently discards npm's
# real exit code in favor of grep's (grep exits 0 whenever any line
# survives the filter). Redirecting to a file first, THEN checking $? of
# the actual npm ci invocation, preserves the real failure signal. The
# previous `| grep ... || true` form masked exactly this: npm ci failed
# (exit 127, one dependency's postinstall missing a compiler) but the RUN
# step still reported success, shipping an empty node_modules.
RUN npm ci --omit=dev > /tmp/npm-ci.log 2>&1; ec=$?; \
    grep -v "^npm warn" /tmp/npm-ci.log || true; \
    if [ "$ec" != "0" ]; then echo "npm ci FAILED (exit $ec)" >&2; exit "$ec"; fi

# ── Stage 3: Production runtime ──────────────────────────────────────────
FROM node:20-alpine AS runtime

# Install tini for proper signal handling and process reaping
RUN apk add --no-cache tini

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 jarvis \
 && adduser  -u 1001 -G jarvis -s /bin/sh -D jarvis

# node_modules comes from native-builder (already includes compiled
# better-sqlite3/node-pty binaries for this exact base image + arch) —
# not re-installed here, so the runtime image never needs a C++ toolchain.
COPY package*.json ./
COPY --from=native-builder /build/node_modules ./node_modules

# Copy backend source
# (orchestrator.cjs was previously COPY'd here but never existed at the
# repo root — build always failed on this exact line, before any native-
# module fix even ran. backend/server.js is the real, sole entrypoint
# per ecosystem.config.cjs's own comment; all real orchestrators live
# under agents/ and backend/services/, already copied below.)
COPY backend/        ./backend/
COPY agents/         ./agents/
COPY plugins/         ./plugins/
COPY utils/          ./utils/

# Copy built frontend from stage 1
COPY --from=frontend-builder /build/frontend/build ./frontend/build

# Create writable runtime directories and set ownership
RUN mkdir -p data logs backups \
 && chown -R jarvis:jarvis /app

# Switch to non-root user
USER jarvis

# Expose only the backend port — nginx proxies externally
EXPOSE 5050

# Health check — PM2 is not used inside Docker; use container-level restarts
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:5050/health || exit 1

# Use tini as PID 1 to handle signals correctly
ENTRYPOINT ["/sbin/tini", "--"]

# Run the server directly — Docker/compose handles restarts
CMD ["node", "--max-old-space-size=400", "backend/server.js"]
